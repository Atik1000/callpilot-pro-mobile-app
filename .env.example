# Copy to .env and adjust. Restart `expo start` after changing.
# Dev backend (default when unset; matches devfront.callpilot.pro, has Jigsaw):
EXPO_PUBLIC_API_URL=https://devapi.callpilot.pro/api/v1
# Production backend (no /jigsaw/* routes yet — contacts fall back to /contacts/):
# EXPO_PUBLIC_API_URL=https://api.callpilot.pro/api/v1

# Incoming calls while the app is closed (Android). Default 'push': CallPilot's
# backend sends an FCM push per call (needs google-services.json and the
# backend CALLPILOT_FCM_* settings, see docs/whatsapp-calling-and-mobile.md).
# 'service' = always-on foreground service instead.
# EXPO_PUBLIC_CALL_WAKE=service
