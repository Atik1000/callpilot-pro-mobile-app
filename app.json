{
  "expo": {
    "name": "CallPilot",
    "slug": "callpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "callpilot",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "pro.callpilot.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "pro.callpilot.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-android-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "CallPilot does not use the camera.",
          "microphonePermission": "CallPilot uses the microphone so you can make and receive calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# react-native-webrtc: JNI-called classes must survive R8.\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
